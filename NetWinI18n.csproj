
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target Frameworks -->
    <TargetFrameworks>net45;net46;net472;net48;net6.0-windows;net7.0-windows;net8.0-windows;net9.0-windows;net10.0-windows</TargetFrameworks>

    <!-- Assembly -->
    <RootNamespace>NetWinI18n</RootNamespace>
    <AssemblyName>NetWinI18n</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- NuGet Package -->
    <PackageId>NetWinI18n</PackageId>
    <Version>2.0.2</Version>
    <Authors>ShengbiYang</Authors>
    <Description>JSON-based multilingual localization library for WinForms applications.</Description>
    <PackageTags>WinForms;Localization;I18n;JSON;Multilingual;Vietnamese</PackageTags>

    <!-- License -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- GitHub Repository -->
    <PackageProjectUrl>https://github.com/Countonme/NetWinI18n</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Countonme/NetWinI18n</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Build and Package -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  
	<PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial stable release of NetWinI18n.</PackageReleaseNotes>
  </PropertyGroup>

  <!-- .NET Framework -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net45' Or '$(TargetFramework)' == 'net46' Or '$(TargetFramework)' == 'net472' Or '$(TargetFramework)' == 'net48'">
    <AutomaticallyUseReferenceAssemblyPackages>true</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>

  <!-- Modern .NET WinForms -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net6.0-windows' Or '$(TargetFramework)' == 'net7.0-windows' Or '$(TargetFramework)' == 'net8.0-windows' Or '$(TargetFramework)' == 'net9.0-windows' Or '$(TargetFramework)' == 'net10.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Dependencies -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Embedded language resources -->
  <ItemGroup>
    <EmbeddedResource Include="Languages\*.json" />
  </ItemGroup>

  <!-- Also package JSON files for external language discovery -->
  <ItemGroup>
    <None Include="Languages\*.json" Pack="true" PackagePath="contentFiles\any\any\Languages\%(Filename)%(Extension)" PackageCopyToOutput="true" Visible="false" />
  </ItemGroup>

  <!-- Windows Forms reference for .NET Framework -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net45' Or '$(TargetFramework)' == 'net46' Or '$(TargetFramework)' == 'net472' Or '$(TargetFramework)' == 'net48'">
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="Languages\de-DE.json" />
    <EmbeddedResource Remove="Languages\fr-FR.json" />
    <EmbeddedResource Remove="Languages\id-ID.json" />
    <EmbeddedResource Remove="Languages\it-IT.json" />
    <EmbeddedResource Remove="Languages\pt-BR.json" />
    <EmbeddedResource Remove="Languages\pt-PT.json" />
  </ItemGroup>

  <!-- Include README and LICENSE in NuGet package -->
<ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />

    <None Include="LICENSE" Pack="true" PackagePath="LICENSE" />
</ItemGroup>

</Project>
